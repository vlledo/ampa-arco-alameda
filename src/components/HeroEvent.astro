---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

interface Props {
  event: CollectionEntry<'events'>;
}

const { event } = Astro.props;
const { title, date, location, poster, posterAlt, shortDescription } = event.data;
const url = `/eventos/${event.id}/`;

const fullDate = new Intl.DateTimeFormat('es-ES', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  hour: '2-digit',
  minute: '2-digit',
}).format(date);
---
<section class="hero-event">
  <div class="container">
    <a href={url} class="hero-link">
      <div class="content">
        <h1>{title}</h1>
        <p class="meta">
          <time datetime={date.toISOString()}>{fullDate}</time> · {location}
        </p>
        <p class="lead">{shortDescription}</p>
        <span class="cta">Más información</span>
      </div>
      <div class="poster">
        <Image src={poster} alt={posterAlt} width={600} height={800} />
      </div>
    </a>
  </div>
</section>

<style>
  .hero-event {
    background: var(--white);
    padding: var(--space-8) 28px;
    border-bottom: 1px solid var(--line);
  }
  .hero-event .container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-8);
    align-items: center;
  }
  .hero-link {
    display: contents;
    color: inherit;
    text-decoration: none;
  }
  .content h1 {
    font-size: var(--fs-display);
    margin-bottom: var(--space-3);
  }
  .meta {
    color: var(--ink-soft);
    font-size: var(--fs-small);
    margin-bottom: var(--space-4);
  }
  .lead {
    color: var(--ink-soft);
    margin-bottom: var(--space-4);
    line-height: 1.6;
  }
  .cta {
    display: inline-block;
    font-weight: 600;
    color: var(--ink);
    border-bottom: 2px solid var(--ampa-green);
    padding-bottom: 2px;
    transition: color 0.15s ease;
  }
  .hero-link:hover .cta {
    color: var(--ampa-dark);
  }
  .poster {
    aspect-ratio: 3/4;
    background: var(--green-soft);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .poster :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (max-width: 768px) {
    .hero-event .container {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }
</style>
