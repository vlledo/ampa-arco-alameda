---
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts');
const posts = allPosts.slice(0, 3).sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---
<section class="news-teaser">
  <div class="container">
    <h2>Últimas noticias</h2>
    {posts.length > 0 ? (
      <div class="news-grid">
        {posts.map(post => {
          const url = `/noticias/${post.id}/`;
          const pubDate = new Intl.DateTimeFormat('es-ES', {
            day: 'numeric',
            month: 'long',
            year: 'numeric',
          }).format(post.data.pubDate);
          return (
            <article class="news-item">
              <a href={url} class="news-link">
                <h3>{post.data.title}</h3>
                <p class="date">{pubDate}</p>
                <p class="excerpt">{post.data.description}</p>
                <span class="cta">Leer más</span>
              </a>
            </article>
          );
        })}
      </div>
    ) : (
      <p class="empty-state">No hay noticias disponibles en este momento.</p>
    )}
    <div class="news-footer">
      <a href="/noticias/" class="view-all">Ver todas las noticias</a>
    </div>
  </div>
</section>

<style>
  .news-teaser {
    padding: var(--space-8) 28px;
    background: var(--bg-secondary);
  }
  h2 {
    margin-bottom: var(--space-6);
  }
  .news-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-6);
    margin-bottom: var(--space-6);
  }
  .news-item {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    transition: border-color 0.15s ease;
  }
  .news-item:hover {
    border-color: var(--ampa-dark);
  }
  .news-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  .news-item h3 {
    margin: 0 0 var(--space-2) 0;
    font-size: 1.25rem;
  }
  .date {
    color: var(--ink-soft);
    font-size: var(--fs-small);
    margin: 0 0 var(--space-2) 0;
  }
  .excerpt {
    color: var(--ink-soft);
    font-size: var(--fs-small);
    margin: var(--space-2) 0;
    line-height: 1.6;
  }
  .cta {
    display: inline-block;
    margin-top: var(--space-3);
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--ink);
    border-bottom: 2px solid var(--ampa-green);
    padding-bottom: 2px;
  }
  .news-footer {
    text-align: center;
  }
  .view-all {
    display: inline-block;
    font-weight: 600;
    color: var(--ampa-dark);
    border: 1px solid var(--ampa-dark);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: all 0.15s ease;
  }
  .view-all:hover {
    background: var(--ampa-dark);
    color: var(--white);
  }
  .empty-state {
    color: var(--ink-soft);
    text-align: center;
    padding: var(--space-6);
  }
</style>
